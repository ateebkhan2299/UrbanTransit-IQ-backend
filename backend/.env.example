DATABASE_URL=sqlite:///./urbantransit_iq.db
# Replace above with PostgreSQL in production:
# DATABASE_URL=postgresql://utiq_admin:change_this_password@localhost:5432/urbantransit_iq

# Required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Key Rotation: To rotate, set a new JWT_SECRET_KEY. Old tokens will instantly invalidate, requiring users to log in again.
JWT_SECRET_KEY=
JWT_ISSUER=urbantransit-iq
JWT_AUDIENCE=urbantransit-iq-api
JWT_EXPIRE_SECONDS=3600
# Optional local seed overrides. Leave blank to generate one-time passwords.
INITIAL_ADMIN_PASSWORD=
INITIAL_OPERATOR_PASSWORD=
INITIAL_ANALYST_PASSWORD=
INITIAL_EVALUATOR_PASSWORD=
