# Backend environment used on Vercel (set these in Vercel Project Settings > Environment Variables)
# PostgreSQL connection string (required for production writes on Vercel read-only FS):
DATABASE_URL=postgresql://user:password@host:5432/urban_transit_iq
# Alternatively keep SQLite locally:
# DATABASE_URL=sqlite:///./urbantransit_iq.db

# Required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Comma-separated allowed browser origins (CORS). Include your frontend URL.
CORS_ORIGINS=https://urban-trasnsit-frontend.vercel.app

# Optional local seed overrides. Leave blank to generate one-time passwords.
INITIAL_ADMIN_PASSWORD=
INITIAL_OPERATOR_PASSWORD=
INITIAL_ANALYST_PASSWORD=
INITIAL_EVALUATOR_PASSWORD=